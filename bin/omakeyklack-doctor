#!/usr/bin/env bash
# Prueft, ob alles da ist, was omakeyklack zum Laufen braucht - und holt es
# auf Wunsch nach.
#
#   omakeyklack-doctor          nur pruefen, nichts aendern
#   omakeyklack-doctor --fix    fehlende Voraussetzungen nachinstallieren
#   omakeyklack-doctor --fix --yes   dasselbe ohne Rueckfragen
#
# Rueckgabewert: 0 wenn alles Noetige da ist, sonst 1.
#
# Kein 'set -e': das Skript sammelt alle Befunde und bricht nicht beim
# ersten fehlenden Paket ab - sonst sieht man immer nur eine Huerde
# gleichzeitig.
set -uo pipefail

# -- Was gebraucht wird ------------------------------------------------

# gstreamer liefert die Gst-Typelib, gst-plugins-base den playbin,
# gst-plugins-good die WAV-/MP3-/FLAC-Dekoder und die Audio-Ausgabe.
PACMAN_DEPS=(python python-gobject gtk3 libayatana-appindicator
             gstreamer gst-plugins-base gst-plugins-good)
AUR_DEPS=(wayvibes-git)

SOUNDPACK_TARBALL="https://codeload.github.com/sahaj-b/wayvibes/tar.gz/refs/heads/main"
SOUNDPACK_SIZE="rund 58 MB Download, 110 MB auf der Platte"

PACKS_DIR="${OMAKEYKLACK_PACKS_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/wayvibes/soundpacks}"
PREFIX="${PREFIX:-$HOME/.local}"

FIX=0
ASSUME_YES=0
for arg in "$@"; do
  case "$arg" in
    --fix) FIX=1 ;;
    --yes|-y) ASSUME_YES=1 ;;
    --help|-h)
      sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//'
      exit 0 ;;
    *) echo "Unbekannte Option: $arg" >&2; exit 2 ;;
  esac
done

# -- Ausgabe -----------------------------------------------------------

if [ -t 1 ]; then
  GREEN=$'\033[32m'; RED=$'\033[31m'; YELLOW=$'\033[33m'; DIM=$'\033[2m'; OFF=$'\033[0m'
else
  GREEN=""; RED=""; YELLOW=""; DIM=""; OFF=""
fi

PROBLEMS=0
PENDING_RELOGIN=0

ok()    { printf '  %s✓%s %s\n' "$GREEN" "$OFF" "$1"; }
warn()  { printf '  %s!%s %s\n' "$YELLOW" "$OFF" "$1"; }
bad()   { printf '  %s✗%s %s\n' "$RED" "$OFF" "$1"; PROBLEMS=$((PROBLEMS + 1)); }
hint()  { printf '    %s%s%s\n' "$DIM" "$1" "$OFF"; }
step()  { printf '\n%s\n' "$1"; }

# Fragt nach - ausser mit --yes, und ausser ohne Terminal (dann: nein).
confirm() {
  [ "$ASSUME_YES" = 1 ] && return 0
  [ -t 0 ] || return 1
  local answer
  read -r -p "    $1 [j/N] " answer
  [[ "$answer" =~ ^([jJ]|[yY])$ ]]
}

# sudo nur, wenn es auch klappen kann.
as_root() {
  if [ "$(id -u)" = 0 ]; then
    "$@"
  elif command -v sudo >/dev/null; then
    sudo "$@"
  else
    echo "    sudo fehlt - bitte von Hand ausfuehren: $*" >&2
    return 1
  fi
}

# -- 1. Arch-Pakete ----------------------------------------------------

check_pacman_deps() {
  step "Systempakete"
  if ! command -v pacman >/dev/null; then
    warn "Kein pacman - das hier ist offenbar kein Arch-System."
    hint "Gebraucht werden: Python 3.10+, PyGObject, GTK 3,"
    hint "libayatana-appindicator, GStreamer mit base- und good-Plugins."
    return
  fi

  local missing=()
  for pkg in "${PACMAN_DEPS[@]}"; do
    pacman -Q "$pkg" &>/dev/null || missing+=("$pkg")
  done

  if [ ${#missing[@]} -eq 0 ]; then
    ok "alle da (${PACMAN_DEPS[*]})"
    return
  fi

  bad "fehlt: ${missing[*]}"
  hint "sudo pacman -S --needed ${missing[*]}"
  [ "$FIX" = 1 ] || return

  if confirm "Jetzt mit pacman nachinstallieren?"; then
    if command -v omarchy-pkg-add >/dev/null; then
      omarchy-pkg-add "${missing[@]}" && PROBLEMS=$((PROBLEMS - 1)) && ok "nachinstalliert"
    else
      as_root pacman -S --needed --noconfirm "${missing[@]}" &&
        PROBLEMS=$((PROBLEMS - 1)) && ok "nachinstalliert"
    fi
  fi
}

# -- 2. wayvibes (AUR) -------------------------------------------------

install_from_aur() {
  local pkg="$1"
  # Omarchy und die ueblichen Helfer koennen das selbst.
  if command -v omarchy-pkg-aur-add >/dev/null; then
    omarchy-pkg-aur-add "$pkg" && return 0
  fi
  for helper in yay paru pikaur; do
    if command -v "$helper" >/dev/null; then
      "$helper" -S --needed --noconfirm "$pkg" && return 0
      return 1
    fi
  done

  # Ohne Helfer: selbst bauen. Braucht base-devel und git.
  echo "    Kein AUR-Helfer gefunden - baue $pkg mit makepkg."
  command -v makepkg >/dev/null || { echo "    makepkg fehlt (Paket base-devel)." >&2; return 1; }
  command -v git >/dev/null || { echo "    git fehlt." >&2; return 1; }

  local build
  build="$(mktemp -d)" || return 1
  # shellcheck disable=SC2064
  trap "rm -rf '$build'" RETURN
  git clone --depth 1 "https://aur.archlinux.org/$pkg.git" "$build/$pkg" || return 1
  ( cd "$build/$pkg" && makepkg -si --noconfirm )
}

check_wayvibes() {
  step "wayvibes (spielt die Toene)"
  if command -v wayvibes >/dev/null; then
    ok "$(command -v wayvibes)"
    return
  fi

  bad "nicht installiert - ohne wayvibes bleibt die Tastatur stumm"
  hint "yay -S ${AUR_DEPS[*]}   (AUR)"
  [ "$FIX" = 1 ] || return

  if confirm "Jetzt aus dem AUR installieren?"; then
    if install_from_aur "${AUR_DEPS[0]}" && command -v wayvibes >/dev/null; then
      PROBLEMS=$((PROBLEMS - 1))
      ok "installiert"
    else
      hint "Fehlgeschlagen - bitte von Hand: yay -S ${AUR_DEPS[*]}"
    fi
  fi
}

# -- 3. Python-Anbindung -----------------------------------------------

# Der Paketcheck oben sagt nur, dass etwas installiert ist. Ob die
# Introspection wirklich traegt, zeigt erst der Import.
check_python_bindings() {
  step "Python-Anbindung"
  command -v python3 >/dev/null || { bad "python3 fehlt"; return; }

  local output
  output="$(python3 - <<'PY' 2>&1
import sys

if sys.version_info < (3, 10):
    print(f"python:zu alt ({sys.version_info.major}.{sys.version_info.minor}, noetig 3.10+)")

try:
    import gi
except ImportError:
    print("gi:python-gobject")
    raise SystemExit(0)

for namespace, version, package in (
    ("Gtk", "3.0", "gtk3"),
    ("AyatanaAppIndicator3", "0.1", "libayatana-appindicator"),
    ("Gst", "1.0", "gstreamer"),
):
    try:
        gi.require_version(namespace, version)
        __import__("gi.repository", fromlist=[namespace])
        getattr(__import__("gi.repository", fromlist=[namespace]), namespace)
    except (ValueError, ImportError, AttributeError):
        # ValueError: Typelib fehlt. ImportError/AttributeError: sie ist da,
        # traegt aber nicht - etwa nach einem halben Upgrade.
        print(f"{namespace}:{package}")
PY
)"

  if [ -z "$output" ]; then
    ok "gi, Gtk 3.0, AyatanaAppIndicator3, Gst 1.0 lassen sich laden"
    return
  fi

  while IFS=: read -r what package; do
    [ -n "$what" ] || continue
    bad "$what nicht nutzbar - fehlendes Paket: $package"
  done <<< "$output"
  hint "Nach dem Nachinstallieren noch einmal pruefen: omakeyklack-doctor"
}

# -- 4. Gruppe input ---------------------------------------------------

check_input_group() {
  step "Leserecht auf die Tastatur"
  if id -nG 2>/dev/null | tr ' ' '\n' | grep -qx input; then
    ok "Benutzer ist in der Gruppe 'input'"
    return
  fi

  # usermod wirkt erst nach dem Neuanmelden - die aktuelle Sitzung sieht
  # die Gruppe noch nicht. Darum getrennt nachsehen.
  if getent group input 2>/dev/null | grep -qw "$USER"; then
    warn "in 'input' eingetragen, aber die laufende Sitzung kennt das noch nicht"
    hint "Einmal ab- und wieder anmelden."
    PENDING_RELOGIN=1
    return
  fi

  bad "Benutzer ist nicht in der Gruppe 'input' - wayvibes hoert nichts"
  hint "sudo usermod -aG input $USER   (danach neu anmelden)"
  [ "$FIX" = 1 ] || return

  if confirm "Jetzt eintragen?"; then
    if as_root usermod -aG input "$USER"; then
      PROBLEMS=$((PROBLEMS - 1))
      PENDING_RELOGIN=1
      ok "eingetragen - wirkt nach dem naechsten Anmelden"
    fi
  fi
}

# -- 5. Soundpacks -----------------------------------------------------

count_packs() {
  local n=0 dir
  for dir in "$PACKS_DIR"/*/; do
    [ -d "$dir" ] && n=$((n + 1))
  done
  echo "$n"
}

fetch_soundpacks() {
  command -v curl >/dev/null || { echo "    curl fehlt." >&2; return 1; }
  command -v tar >/dev/null || { echo "    tar fehlt." >&2; return 1; }

  local tmp
  tmp="$(mktemp -d)" || return 1
  # shellcheck disable=SC2064
  trap "rm -rf '$tmp'" RETURN

  echo "    Lade Soundpacks von github.com/sahaj-b/wayvibes ..."
  # Der Fortschrittsbalken ist nur am Terminal lesbar; in einem Logfile
  # waeren es tausend Zeichen Rauschen.
  local progress=(-s)
  [ -t 1 ] && progress=(--progress-bar)
  curl -fL "${progress[@]}" "$SOUNDPACK_TARBALL" -o "$tmp/wayvibes.tar.gz" || return 1

  mkdir -p "$PACKS_DIR" || return 1
  # --strip-components=2 wirft <repo>/soundpacks/ ab, uebrig bleiben die
  # Pack-Verzeichnisse selbst.
  tar -xzf "$tmp/wayvibes.tar.gz" -C "$PACKS_DIR" \
      --strip-components=2 --wildcards '*/soundpacks/*' || return 1
}

check_soundpacks() {
  step "Soundpacks"
  local count
  count="$(count_packs)"

  if [ "$count" -gt 0 ]; then
    ok "$count Pack(s) in $PACKS_DIR"
    return
  fi

  bad "keine Packs in $PACKS_DIR - es gibt nichts auszuwaehlen"
  hint "Packs von mechvibes.com oder aus dem wayvibes-Repo dort ablegen."
  [ "$FIX" = 1 ] || return

  echo "    Das wayvibes-Projekt liefert 22 fertige Packs ($SOUNDPACK_SIZE)."
  if confirm "Die jetzt herunterladen?"; then
    if fetch_soundpacks && [ "$(count_packs)" -gt 0 ]; then
      PROBLEMS=$((PROBLEMS - 1))
      ok "$(count_packs) Packs nach $PACKS_DIR entpackt"
    else
      hint "Download fehlgeschlagen - Packs von Hand nach $PACKS_DIR legen."
    fi
  fi
}

# -- 6. PATH -----------------------------------------------------------

check_path() {
  # Nur interessant, wenn nach ~/.local installiert wurde.
  [ -x "$PREFIX/bin/omakeyklack" ] || return
  step "Aufrufbarkeit"
  case ":$PATH:" in
    *":$PREFIX/bin:"*) ok "$PREFIX/bin liegt im PATH" ;;
    *)
      warn "$PREFIX/bin liegt nicht im PATH - 'omakeyklack' wird nicht gefunden"
      hint "echo 'export PATH=\"$PREFIX/bin:\$PATH\"' >> ~/.bashrc"
      ;;
  esac
}

# -- Ablauf ------------------------------------------------------------

printf 'omakeyklack - Voraussetzungen pruefen\n'

check_pacman_deps
check_wayvibes
check_python_bindings
check_input_group
check_soundpacks
check_path

echo
if [ "$PROBLEMS" -gt 0 ]; then
  printf '%s%d Punkt(e) offen.%s' "$RED" "$PROBLEMS" "$OFF"
  if [ "$FIX" = 1 ]; then
    printf ' Siehe die Hinweise oben.\n'
  else
    printf ' Mit "omakeyklack-doctor --fix" nachinstallieren.\n'
  fi
  exit 1
fi

printf '%sAlles da.%s\n' "$GREEN" "$OFF"
if [ "$PENDING_RELOGIN" = 1 ]; then
  printf '%sVorher noch einmal ab- und anmelden, sonst darf wayvibes die Tastatur nicht lesen.%s\n' \
    "$YELLOW" "$OFF"
fi
exit 0
